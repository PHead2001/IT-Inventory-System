{
  "name": "it-inventory-system",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "11.11.x"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:export:memory": "node --conditions=react-server --expose-gc --import tsx tests/integration/export-memory.ts",
    "test:watch": "vitest",
    "db:start": "node scripts/db.mjs start",
    "db:stop": "node scripts/db.mjs stop",
    "db:reset": "node scripts/db.mjs reset",
    "db:types": "node scripts/db.mjs types",
    "db:types:check": "node scripts/db.mjs types-check",
    "db:deliver:production": "node scripts/production-db.mjs",
    "test:db": "node scripts/db.mjs test",
    "validate:db": "node scripts/db.mjs validate",
    "build": "next build",
    "test:e2e": "node scripts/e2e.mjs",
    "validate:app": "node scripts/validate.mjs app",
    "validate": "node scripts/validate.mjs all",
    "test:e2e:list": "playwright test --list"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@supabase/ssr": "0.12.6",
    "@supabase/supabase-js": "2.115.0",
    "@tailwindcss/postcss": "4.3.3",
    "@zxing/browser": "0.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jsbarcode": "3.12.3",
    "jsqr": "1.4.0",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "three": "0.185.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jsbarcode": "3.11.4",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "pg": "8.23.0",
    "pngjs": "5.0.0",
    "prettier": "3.9.6",
    "supabase": "2.116.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  },
  "type": "module"
}
